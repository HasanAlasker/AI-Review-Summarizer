generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal
  createdAt   DateTime @default(now())
  reviews     Review[]
  summary     Summary?
}

model Review {
  id        String   @id @default(uuid())
  author    String
  rating    Int
  content   String
  createdAt DateTime @default(now())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

model Summary {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  expiresAt DateTime
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id])
}
